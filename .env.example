# Local SQLite is the default. Docker Compose points this at Postgres.
DATABASE_URL=sqlite:///./data/reading.db
UPLOAD_DIR=./data/uploads
JWT_PRIVATE_KEY_PATH=./data/keys/private.pem
JWT_PUBLIC_KEY_PATH=./data/keys/public.pem
# Or paste PEM text with literal \n for serverless hosts.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SEED_DEMO=1

# Optional S3-compatible media (Cloudflare R2 or AWS S3).
# Leave blank to store recordings on local disk under UPLOAD_DIR.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
